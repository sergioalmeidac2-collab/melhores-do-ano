// ----------------------------------------------------------------------------
// MELHORES DO ANO — schema de dados
//
// Postgres (Supabase), tanto em dev quanto em produção, para evitar
// divergências de comportamento entre ambientes (enums, tipos de data etc).
//
// Duas connection strings, porque o pooler do Supabase (Supavisor, modo
// "Transaction", porta 6543) não suporta os locks de sessão que o Prisma
// Migrate precisa — usar só o pooler faz `prisma migrate deploy` travar ou
// falhar de forma imprevisível:
//   DATABASE_URL -> pooler modo "Transaction" (porta 6543), usado pela
//                   aplicação em runtime (serverless)
//   DIRECT_URL   -> pooler modo "Session" (mesmo host, porta 5432), usado só
//                   por `prisma migrate deploy`
// Os dois vêm da aba "Connection string" do Supabase (Settings -> Database).
// NÃO use a opção "Direct connection" (host db.xxxx.supabase.co) para
// DIRECT_URL — ela é IPv6-only e não conecta na maioria dos ambientes
// (Vercel, redes sem suporte a IPv6 etc). Use a aba "Session" do pooler,
// que é IPv4 e já suporta os locks que o Migrate precisa.
// ----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// votingStatus e status abaixo são String (não enum do Prisma) com os valores
// restritos por validação Zod na camada de API:
//   votingStatus: "NOT_STARTED" | "OPEN" | "CLOSED"
//   status (Vote): "VALID" | "SUSPICIOUS" | "INVALID" | "SKIPPED"
// Poderiam virar enum nativo do Postgres numa iteração futura; mantidos como
// String por ora para não introduzir uma migração de tipo sem banco real para testar.

model EventSettings {
  id            String       @id @default(cuid())
  eventName     String       @default("Melhores do Ano")
  eventYear     Int          @default(2026)
  city          String       @default("")
  logoUrl       String?
  heroTitle     String       @default("MELHORES DO ANO")
  heroSubtitle  String       @default("Escolha as empresas que mais se destacaram na sua cidade.")
  primaryColor  String       @default("#c98a1c")
  rulesText     String       @default("")
  votesPerCategory Int       @default(1)
  votingStatus  String       @default("NOT_STARTED")
  startsAt      DateTime?
  endsAt        DateTime?
  autoSchedule  Boolean      @default(false)
  updatedAt     DateTime     @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin") // admin | editor
  createdAt    DateTime @default(now())
  auditLogs    AuditLog[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  emoji       String   @default("🏆")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies CategoryCompany[]
  votes     Vote[]
  instagramCommentVotes InstagramCommentVote[]

  @@index([active, order])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  instagram   String?
  phone       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories CategoryCompany[]
  votes      Vote[]
  instagramCommentVotes InstagramCommentVote[]
}

// Junction table: uma empresa pode participar de várias categorias
model CategoryCompany {
  id         String   @id @default(cuid())
  categoryId String
  companyId  String
  order      Int      @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([categoryId, companyId])
  @@index([categoryId])
}

// Uma pessoa (identificada primariamente pelo telefone normalizado)
model Participant {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique // formato normalizado E.164-like: 55DDDNNNNNNNNN
  instagram     String?
  email         String?
  city          String?
  neighborhood  String?
  howFoundOut   String?
  marketingOptIn Boolean @default(false)
  createdAt     DateTime @default(now())

  votes Vote[]
}

model VoteSource {
  id           String   @id @default(cuid())
  label        String   // ex: "QR Code Restaurante", "Instagram Bio"
  slug         String   @unique
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  createdAt    DateTime @default(now())

  votes Vote[]
}

model Vote {
  id             String                @id @default(cuid())
  categoryId     String
  companyId      String? // null quando o participante pulou a categoria (status SKIPPED)
  participantId  String
  voteSourceId   String?

  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?

  ipHash         String
  userAgent      String?
  sessionId      String?

  status         String               @default("VALID")
  reviewNote     String?

  consentTerms      Boolean @default(false)
  consentMarketing  Boolean @default(false)

  createdAt      DateTime @default(now())

  category    Category    @relation(fields: [categoryId], references: [id])
  company     Company?    @relation(fields: [companyId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])
  voteSource  VoteSource? @relation(fields: [voteSourceId], references: [id])

  // Regra antifraude principal: 1 voto (ou 1 pulo) por telefone por categoria
  @@unique([participantId, categoryId])
  @@index([categoryId, companyId])
  @@index([createdAt])
  @@index([ipHash, createdAt])
}

model BlockedPhone {
  id        String   @id @default(cuid())
  phone     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model BlockedSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

// Análise de votação por comentários do Instagram — canal alternativo/manual,
// inspirado em como concursos "Melhores do Ano" costumam rodar por lá: a
// organização publica um post por categoria e o público vota comentando e
// mencionando o @ da empresa. Como não temos acesso à Instagram Graph API
// (exige app da Meta aprovado + conta comercial do cliente), o admin cola os
// comentários manualmente (exportados do Instagram ou copiados à mão) e o
// sistema classifica cada um. Ver README para o caminho de evolução para
// importação automática via webhook quando o cliente tiver o app da Meta.
model InstagramCommentVote {
  id             String   @id @default(cuid())
  categoryId     String
  companyId      String? // null quando não foi possível identificar uma menção válida
  username       String // @ de quem comentou
  rawText        String
  status         String // "VALID" | "MULTIPLE_VOTE" | "MULTIPLE_MENTION" | "NO_MENTION" | "EXTRA_TEXT"
  createdAt      DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  company  Company? @relation(fields: [companyId], references: [id])

  @@index([categoryId, status])
  @@index([categoryId, username])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id])
}
