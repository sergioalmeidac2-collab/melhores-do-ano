# Copie este arquivo para .env e preencha com valores reais.

# Duas connection strings do mesmo projeto Supabase (Settings -> Database ->
# Connection string). NÃO é a "Project URL" de Settings -> API (essa começa
# com https://xxxx.supabase.co e é para o SDK JS/REST, não para o Prisma) —
# o valor certo aqui sempre começa com postgresql://
#
# DATABASE_URL: aba "Transaction" (pooler, porta 6543) — usada pela aplicação
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: aba "Session" ou "Direct connection" (porta 5432) — usada só
# por `prisma migrate deploy`, porque o pooler não suporta os locks que as
# migrations precisam
DIRECT_URL="postgresql://postgres:SENHA@db.PROJECT_REF.supabase.co:5432/postgres"

# String aleatória longa usada para assinar o cookie de sessão do admin.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="troque-por-uma-string-aleatoria-longa-e-secreta"

# Usados apenas pelo script de seed (prisma/seed.ts) para criar o admin inicial.
# Opcionais: se omitidos, usa admin@melhoresdoano.com / TrocarSenha123!
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
