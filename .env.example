# Copie este arquivo para .env e preencha com valores reais.

# Connection string do Postgres (Supabase: Settings -> Database -> Connection string
# -> modo "Transaction pooler", porta 6543). NÃO é a "Project URL" de
# Settings -> API (essa começa com https://xxxx.supabase.co e é para o SDK
# JS/REST, não para o Prisma) — o valor certo aqui começa com postgresql://
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true"

# String aleatória longa usada para assinar o cookie de sessão do admin.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="troque-por-uma-string-aleatoria-longa-e-secreta"

# Usados apenas pelo script de seed (prisma/seed.ts) para criar o admin inicial.
# Opcionais: se omitidos, usa admin@melhoresdoano.com / TrocarSenha123!
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
